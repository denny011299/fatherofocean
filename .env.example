APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production (oceanlink.my.id): use ONE canonical URL, e.g. https://oceanlink.my.id
# Must match how users open the site (www vs non-www). Mismatch causes 419 on login.

WABLAS_BASE_URL=https://tegal.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pelayaran
DB_USERNAME=root
DB_PASSWORD=
# Keep false on shared hosting — persistent PDO holds MySQL connections open.
DB_PERSISTENT=false
DB_CONNECT_TIMEOUT=5

# Shared hosting: use file drivers to avoid extra MySQL connections per request.
# database session + cache + queue can exhaust low max_connections (20–50).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for host-only cookies. Use .oceanlink.my.id only if www + apex must share sessions.
SESSION_DOMAIN=
# Production HTTPS: set true, or omit and rely on TrustProxies + secure detection.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use sync unless a dedicated queue worker is running; database queue adds load.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
